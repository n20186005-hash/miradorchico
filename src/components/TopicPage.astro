---
import type { Lang } from '../i18n/utils';
import { TOPICS, type Topic } from '../i18n/topics';
import { ATTRACTION } from '../data/attraction';

interface Props {
  lang: Lang;
  topic: Topic;
}
const { lang, topic } = Astro.props;
const _ = (s: any) => typeof s === 'string' ? s : (s[lang] || s.es || s.pt || '');

const homeUrl = `/${lang}/`;
const topicUrl = `/${lang}/${topic.slug}/`;
const abs = (path: string) => new URL(path, Astro.site ?? new URL(ATTRACTION.siteUrl)).href;
const siteUrl = abs('/');
const topicAbs = abs(topicUrl);

const related = TOPICS.filter((t) => t.slug !== topic.slug);

const stripTags = (s: string) => s.replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Punto Panorámico - Circuito Chico', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: stripTags(_(topic.h1)), item: topicAbs },
  ],
};

const faqPage = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: topic.faq.map((item) => ({
    '@type': 'Question',
    name: stripTags(_(item.q)),
    acceptedAnswer: { '@type': 'Answer', text: stripTags(_(item.a)) },
  })),
};

const webPage = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: stripTags(_(topic.h1)),
  description: stripTags(_(topic.description)),
  url: topicAbs,
  about: { '@id': `${siteUrl}#attraction` },
  isPartOf: { '@id': `${siteUrl}#website` },
};

const jsonLd = [breadcrumb, faqPage, webPage]
  .map((p) => `<script type="application/ld+json">${JSON.stringify(p)}</script>`)
  .join('');
---

<article class="max-w-3xl mx-auto px-6 pt-28 pb-16">
  <!-- Breadcrumb -->
  <nav aria-label="Breadcrumb" class="text-xs text-[color:var(--color-moss)]/60 mb-6">
    <a href={homeUrl} class="link-underline">Punto Panorámico - Circuito Chico</a>
    <span class="mx-2" aria-hidden="true">›</span>
    <span>{_(topic.h1)}</span>
  </nav>

  <h1 class="font-display text-4xl md:text-5xl leading-tight text-[color:var(--color-ink)]">{_(topic.h1)}</h1>
  <p class="mt-6 text-lg leading-relaxed text-[color:var(--color-moss)]">{_(topic.intro)}</p>

  <div class="mt-12 space-y-12">
    {topic.sections.map((section) => (
      <section>
        <h2 class="font-display text-2xl md:text-3xl text-[color:var(--color-ink)]">{_(section.heading)}</h2>
        <p class="mt-4 text-[color:var(--color-moss)] leading-relaxed" set:html={_(section.body)} />
      </section>
    ))}
  </div>

  <!-- FAQ -->
  <section class="mt-16" id="faq">
    <h2 class="font-display text-2xl md:text-3xl text-[color:var(--color-ink)] mb-6">FAQ</h2>
    <div class="space-y-4">
      {topic.faq.map((item) => (
        <details class="group rounded-2xl border border-black/10 bg-white overflow-hidden">
          <summary class="cursor-pointer flex justify-between items-center gap-4 list-none p-5 md:p-6">
            <span class="font-display text-lg leading-snug">{_(item.q)}</span>
            <span class="text-2xl text-[color:var(--color-emerald)] flex-shrink-0 transition-transform duration-300 group-open:rotate-45">+</span>
          </summary>
          <div class="px-5 md:px-6 pb-5 md:pb-6">
            <p class="text-[color:var(--color-moss)] leading-relaxed text-sm md:text-base" set:html={_(item.a)} />
          </div>
        </details>
      ))}
    </div>
  </section>

  <!-- Related guides -->
  <section class="mt-16 p-6 bg-[color:var(--color-mist)] rounded-2xl">
    <h2 class="font-display text-xl text-[color:var(--color-ink)] mb-4">Guias relacionadas</h2>
    <ul class="space-y-2 text-sm">
      {related.map((t) => (
        <li>
          <a href={`/${lang}/${t.slug}/`} class="link-underline text-[color:var(--color-emerald)]">{_(t.h1)}</a>
        </li>
      ))}
      <li>
        <a href={homeUrl} class="link-underline text-[color:var(--color-emerald)]">Punto Panorámico — guía principal</a>
      </li>
    </ul>
  </section>

  <div class="mt-12 pt-8 border-t border-black/10">
    <a href={homeUrl} class="link-underline text-[color:var(--color-emerald)]">← {_(topic.label)} · Volver a la guía principal</a>
  </div>
</article>
<Fragment set:html={jsonLd} />
