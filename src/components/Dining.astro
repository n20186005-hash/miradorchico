---
// ─────────────────────────────────────────────────────────────────────────────
// "Gastronomía" section.
//
// Purpose (SEO): GSC shows the page getting impressions for "restaurant" style
// queries it does not yet answer. This section closes that intent gap with an
// H2 + H3 structure, while staying orientation-only (no prices, no commercial
// endorsement) to match the site's editorial policy.
//
// Accuracy note: the public terrace has no kiosk. The Restaurant Punto
// Panorámico is a separate private business right beside it — the copy makes
// that distinction explicit instead of claiming "no services anywhere".
// ─────────────────────────────────────────────────────────────────────────────
import type { Lang } from '../i18n/utils';
import { dining } from '../i18n/translations';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const _ = (s: any) => (typeof s === 'string' ? s : s[lang] || s.es || s.pt || '');
---
<section id="dining" class="bg-[color:var(--color-mist)] py-24 md:py-32">
  <div class="max-w-7xl mx-auto px-6">
    <div class="max-w-3xl">
      <div class="text-xs uppercase tracking-[0.25em] text-[color:var(--color-emerald)]">{_(dining.sectionNum)}</div>
      <h2 class="font-display text-4xl md:text-5xl mt-4 leading-tight" set:html={_(dining.heading)} />
      <p class="mt-6 text-[color:var(--color-moss)]/80">{_(dining.subtitle)}</p>
    </div>

    <div class="mt-12 grid md:grid-cols-3 gap-6">
      {dining.items.map((item) => (
        <article class="flex flex-col rounded-3xl bg-white border border-black/5 p-7">
          <h3 class="font-display text-xl leading-snug text-[color:var(--color-ink)]">{_(item.name)}</h3>
          <div class="mt-2 text-[11px] uppercase tracking-[0.14em] text-[color:var(--color-emerald)]">{_(item.type)}</div>
          <p class="mt-4 flex-1 text-sm leading-relaxed text-[color:var(--color-moss)]">{_(item.desc)}</p>
          <div class="mt-5 border-t border-black/5 pt-4 text-xs text-[color:var(--color-moss)]/70">
            <span aria-hidden="true">📍</span> {_(item.where)}
          </div>
        </article>
      ))}
    </div>

    <div class="mt-8 flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <a href="#transport" class="link-underline text-sm text-[color:var(--color-emerald)]">
        {_(dining.transportLink)} →
      </a>
      <p class="max-w-xl text-xs leading-relaxed text-[color:var(--color-moss)]/50">{_(dining.disclaimer)}</p>
    </div>
  </div>
</section>
