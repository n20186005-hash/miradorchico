---
import type { Lang } from '../i18n/utils';
import { hero } from '../i18n/translations';
import { ATTRACTION } from '../data/attraction';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const _ = (s: any) => typeof s === 'string' ? s : (s[lang] || s.es || s.pt || '');
const gmapsUrl = ATTRACTION.mapsShareUrl;
---
<section id="top" class="hero-bg relative min-h-[100vh] flex items-end pt-24 overflow-hidden">
  <img
    src={ATTRACTION.heroImage}
    alt={`${ATTRACTION.fullName} - Main view in ${ATTRACTION.city}, ${ATTRACTION.country}`}
    class="absolute inset-0 w-full h-full object-cover"
    width="1920"
    height="1280"
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />
  <div class="absolute inset-0" style="background: linear-gradient(180deg, rgba(11,31,26,.15) 0%, rgba(11,31,26,.55) 55%, rgba(11,31,26,.85) 100%)"></div>
  <div class="rain absolute inset-0"></div>
  <div class="relative max-w-7xl mx-auto px-6 pb-16 w-full text-white">
    <p class="mb-5 text-xs md:text-sm uppercase tracking-[0.22em] text-white/75">{ATTRACTION.fullName} · {ATTRACTION.city}, {ATTRACTION.state}, {ATTRACTION.country}</p>
    <div class="flex items-center gap-3 mb-6">
      <span class="chip text-white/90 text-xs px-3 py-1 rounded-full bg-white/10">{_(hero.chip1)}</span>
      <span class="chip text-white/90 text-xs px-3 py-1 rounded-full bg-white/10">{_(hero.chip2)}</span>
      <span class="chip text-white/90 text-xs px-3 py-1 rounded-full bg-white/10">{_(hero.chip3)}</span>
    </div>
    <div class="font-display font-semibold leading-[0.95] tracking-tight text-5xl md:text-7xl lg:text-8xl max-w-5xl" set:html={_(hero.title)} />
    <p class="mt-6 max-w-2xl text-white/85 text-lg md:text-xl leading-relaxed">{_(hero.subtitle)}</p>
    <div class="mt-8 flex flex-wrap items-center gap-3">
      <a href={gmapsUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 bg-white/15 hover:bg-white/25 backdrop-blur border border-white/20 rounded-full px-5 py-3 text-sm font-medium transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/><circle cx="12" cy="9" r="2.5"/></svg>
        {_(hero.viewMap)}
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
      <a href="#transport" class="inline-flex items-center gap-2 bg-white text-[color:var(--color-ink)] hover:bg-white/90 rounded-full px-5 py-3 text-sm font-medium transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3h8a3 3 0 0 1 3 3v9H5V6a3 3 0 0 1 3-3z"/><path d="M7 19v2"/><path d="M17 19v2"/><circle cx="8" cy="17" r="1.5"/><circle cx="16" cy="17" r="1.5"/><path d="M7 11h10"/></svg>
        {_(hero.howToGet)}
      </a>
    </div>
    <div class="mt-10 grid grid-cols-2 md:grid-cols-4 gap-6 max-w-3xl">
      <div><div class="num-display text-4xl md:text-5xl">4.9</div><div class="text-xs uppercase tracking-widest text-white/70">{_(hero.statLength)}</div></div>
      <div><div class="num-display text-4xl md:text-5xl">16,038</div><div class="text-xs uppercase tracking-widest text-white/70">{_(hero.statReviews)}</div></div>
      <div><div class="num-display text-4xl md:text-5xl">24 h</div><div class="text-xs uppercase tracking-widest text-white/70">{_(hero.statFalls)}</div></div>
      <div><div class="num-display text-4xl md:text-5xl">Bariloche</div><div class="text-xs uppercase tracking-widest text-white/70">{_(hero.statFlow)}</div></div>
    </div>
  </div>
</section>
