---
import type { Lang } from '../i18n/utils';
import { sources, partners, imageCredit } from '../i18n/translations';
import { ATTRACTION } from '../data/attraction';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const _ = (s: any) => typeof s === 'string' ? s : (s[lang] || s.es || s.pt || '');

const mapsEntry = {
  name: sources.mapsListing,
  url: ATTRACTION.mapsShareUrl,
  note: sources.mapsNote,
};
const allSources = [...partners.items, mapsEntry];
---
<section id="sources" class="bg-[color:var(--color-mist)] py-24 md:py-32">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-xs uppercase tracking-[0.25em] text-[color:var(--color-emerald)]">{_(sources.sectionNum)}</div>
    <h2 class="font-display text-4xl md:text-6xl mt-4" set:html={_(sources.heading)} />
    <p class="mt-6 max-w-3xl text-[color:var(--color-moss)]/80 leading-relaxed">{_(sources.intro)}</p>

    <div class="mt-12 grid md:grid-cols-2 lg:grid-cols-4 gap-4">
      {allSources.map((s) => (
        <a
          href={s.url}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-2xl bg-white border border-black/5 p-5 card-hover block"
        >
          <div class="text-[10px] uppercase tracking-[0.18em] text-[color:var(--color-emerald)]">{_(sources.officialLabel)}</div>
          <div class="mt-3 text-sm font-medium text-[color:var(--color-ink)] leading-relaxed">{_(s.name)}</div>
          <p class="mt-2 text-xs text-[color:var(--color-moss)]/70 leading-relaxed">{_(s.note)}</p>
        </a>
      ))}
    </div>

    <!-- Image property / copyright notice -->
    <div class="mt-10 rounded-2xl border border-black/10 bg-white p-6 md:p-7">
      <div class="text-xs uppercase tracking-widest text-[color:var(--color-emerald)]">{_(sources.imageCreditTitle)}</div>
      <p class="mt-3 text-sm text-[color:var(--color-moss)] leading-relaxed">{_(imageCredit)}</p>
    </div>
  </div>
</section>
