---
import '../../../src/styles/global.css';
import { LANGUAGES, type Lang } from '../../i18n/utils';
import { meta } from '../../i18n/translations';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Hero from '../../components/Hero.astro';
import EntityIntro from '../../components/EntityIntro.astro';
import Marquee from '../../components/Marquee.astro';
import Manifesto from '../../components/Manifesto.astro';
import Highlights from '../../components/Highlights.astro';
import PracticalInfo from '../../components/PracticalInfo.astro';
import Weather from '../../components/Weather.astro';
import ClimateTides from '../../components/ClimateTides.astro';
import Transport from '../../components/Transport.astro';
import LocationMap from '../../components/LocationMap.astro';
import Dining from '../../components/Dining.astro';
import Encyclopedia from '../../components/Encyclopedia.astro';
import Ecology from '../../components/Ecology.astro';
import Gallery from '../../components/Gallery.astro';
import Reviews from '../../components/Reviews.astro';
import Surrounding from '../../components/Surrounding.astro';
import Faq from '../../components/Faq.astro';
import SourcesSection from '../../components/SourcesSection.astro';
import LeaveNoTrace from '../../components/LeaveNoTrace.astro';
import Footer from '../../components/Footer.astro';
import StructuredData from '../../components/StructuredData.astro';
import { TOPICS } from '../../i18n/topics';

const guidesHeading: Record<Lang, string> = {
  zh: '相关攻略',
  en: 'Related guides',
  it: 'Guide correlate',
  es: 'Guías relacionadas',
};

export function getStaticPaths() {
  return LANGUAGES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const _ = (s: any) => typeof s === 'string' ? s : (s[lang] || s.es || s.pt || '');
const title = _(meta.title);
const desc = _(meta.description);
---
<BaseLayout lang={lang} title={title} description={desc}>
  <Nav lang={lang} />
  <Hero lang={lang} />
  <EntityIntro lang={lang} />
  <Marquee />
  <Manifesto lang={lang} />
  <Highlights lang={lang} />
  <PracticalInfo lang={lang} />
  <Weather lang={lang} />
  <ClimateTides lang={lang} />
  <Transport lang={lang} />
  <LocationMap lang={lang} />
  <Dining lang={lang} />
  <Encyclopedia lang={lang} />
  <Ecology lang={lang} />
  <Gallery lang={lang} />
  <Reviews lang={lang} />
  <Surrounding lang={lang} />
  <LeaveNoTrace lang={lang} />
  <Faq lang={lang} />
  <SourcesSection lang={lang} />

  <!-- Related guides: internal links to topic pages -->
  <section class="bg-[color:var(--color-mist)] border-t border-black/5">
    <div class="max-w-3xl mx-auto px-6 py-14">
      <h2 class="font-display text-2xl md:text-3xl text-[color:var(--color-ink)] mb-6">{guidesHeading[lang]}</h2>
      <ul class="grid sm:grid-cols-3 gap-4">
        {TOPICS.map((tp) => (
          <li>
            <a href={`/${lang}/${tp.slug}/`} class="block rounded-2xl border border-black/10 bg-white p-5 hover:border-[color:var(--color-emerald)] transition">
              <span class="font-display text-lg text-[color:var(--color-ink)]">{tp.h1[lang]}</span>
              <span class="block mt-2 text-sm text-[color:var(--color-moss)]">{tp.description[lang]}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Footer lang={lang} />
  <StructuredData lang={lang} />
</BaseLayout>
